<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/textViewSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setări afișare"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewDimensiune"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dimensiune text"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textViewSettingsTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editTextDimensiune"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="ex: 20"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/textViewDimensiune"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewCuloare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Culoare text"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/editTextDimensiune"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/radioGroupCulori"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/textViewCuloare"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/radioRosu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Roșu" />

        <RadioButton
            android:id="@+id/radioVerde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verde" />

        <RadioButton
            android:id="@+id/radioAlbastru"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Albastru" />
    </RadioGroup>

    <Button
        android:id="@+id/buttonSalveazaSetari"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Salvează setările"
        app:layout_constraintTop_toBottomOf="@id/radioGroupCulori"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
