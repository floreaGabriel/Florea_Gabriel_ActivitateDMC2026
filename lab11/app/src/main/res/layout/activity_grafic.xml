<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".grafic_activity">

    <com.florea_gabriel.lab11.ChartView
        android:id="@+id/view"
        android:layout_width="314dp"
        android:layout_height="451dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.926" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="349dp"
        android:layout_height="95dp"
        android:layout_marginTop="52dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/radioButtonPieChart"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:text="PieChart" />

        <RadioButton
            android:id="@+id/radioButtonBarChart"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="BarChart" />

        <RadioButton
            android:id="@+id/radioButtonColumnChart"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="ColumnChart" />
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>